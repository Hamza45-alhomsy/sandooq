generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int        @id @default(autoincrement())
  uid               String     @unique
  email             String     @unique
  fullName          String
  phone             String?
  roleId            Int
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  auditLogs         AuditLog[]
  uploadedDocuments Document[]
  approvedTransactions    Transaction[]    @relation("ApprovedTransactions")
  transactions            Transaction[]
  role              Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)
  ownedWorkspaces   Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("InvitationSender")

  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  users       User[]
  workspaceMembers WorkspaceMember[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  resource  String
  action    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model Fund {
  id             Int           @id @default(autoincrement())
  name           String        @default("Main Fund")
  currentBalance Float         @default(0)
  currency       String        @default("SYP")
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  fundTransactions   FundTransaction[]
  workspaceId     Int?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("funds")
}

model Transaction {
  id           Int          @id @default(autoincrement())
  transactionNumber  String       @unique
  type         String
  status       String       @default("pending")
  totalAmount  Float
  description  String?
  userId       Int
  approvedById Int?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  documents    Document[]
  notes        String?   @db.Text
  items        TransactionItem[]
  approvedBy   User?        @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction)
  fundTransactions  FundTransaction[]
  workspaceId    Int?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([transactionNumber])
  @@index([approvedById], map: "transactions_approvedById_fkey")
  @@map("transactions")
}

model TransactionItem {
  id          Int       @id @default(autoincrement())
  transactionId     Int
  description String
  quantity    Float     @default(1)
  unitPrice   Float
  totalPrice  Float
  categoryId  Int?
  createdAt   DateTime  @default(now())
  category    Category? @relation(fields: [categoryId], references: [id])
  transaction       Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "transaction_items_categoryId_fkey")
  @@index([transactionId], map: "transaction_items_transactionId_fkey")
  @@map("transaction_items")
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String
  nameAr      String?
  type        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       TransactionItem[]
  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("categories")
  @@unique([workspaceId, name])
}

model FundTransaction {
  id            Int      @id @default(autoincrement())
  transactionId       Int      
  fundId        Int
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  description   String?
  createdAt     DateTime @default(now())
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: NoAction)
  transaction         Transaction    @relation(fields: [transactionId], references: [id], onDelete: NoAction)
  workspaceId    Int?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([fundId, createdAt])
  @@map("fund_transactions")
}

model Document {
  id           Int      @id @default(autoincrement())
  transactionId      Int
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById Int
  description  String?
  createdAt    DateTime @default(now())
  transaction        Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: NoAction)
  workspaceId      Int?
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@index([uploadedById], map: "documents_uploadedById_fkey")
  @@map("documents")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction)
  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String
  value       String
  description String?
  group       String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("settings")
  @@unique([workspaceId, key])
}

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: NoAction)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  funds       Fund[]
  transactions Transaction[]
  categories  Category[]
  fundTransactions FundTransaction[]
  documents   Document[]
  auditLogs   AuditLog[]
  settings    Setting[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  userId      Int
  roleId      Int
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  email       String
  roleId      Int
  token       String   @unique
  invitedById Int
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: NoAction)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}
